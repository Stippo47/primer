{
  "id": "night",
  "title": "Night",
  "after": "Kurzgesagt",
  "fonts": { "ui": "Outfit", "art": "Outfit" },

  "motion": { "bounce": 0.3, "overshoot": 0.45, "pop": 1.15, "squash": 0.1, "idle": 1, "captionRise": 14 },

  "chrome": {
    "gutter": 16,
    "ground": "#0b0e2a",
    "text": "#ffffff",
    "key": "#ffb238",
    "caption": { "size": 24, "weight": 600, "lineHeight": 1.28, "align": "center", "valign": "center", "tracking": 0, "indent": 6, "top": 644 },
    "tag": { "fill": "rgba(255,178,56,0.14)", "text": "#ffb238", "border": "1px solid rgba(255,178,56,0.5)", "radius": 99, "weight": 700, "tracking": 0.08, "upper": true },
    "bar": { "height": 8, "radius": 99, "track": "rgba(255,255,255,0.16)", "fill": "linear-gradient(90deg,#3de0c8,#58a6ff)", "shine": 0, "glow": "0 0 14px rgba(61,224,200,0.6)" },
    "close": { "color": "rgba(255,255,255,0.62)", "weight": 2.4 },
    "button": {
      "height": 56, "radius": 28, "depth": 0, "size": 17, "weight": 700, "tracking": 0.02, "upper": false,
      "fill": "linear-gradient(90deg,#3de0c8,#58a6ff)", "edge": "transparent", "text": "#0b0e2a", "border": "none",
      "glow": "0 0 26px rgba(61,224,200,0.5)",
      "offFill": "rgba(255,255,255,0.07)", "offEdge": "transparent", "offText": "rgba(255,255,255,0.36)", "offBorder": "1px solid rgba(255,255,255,0.13)"
    }
  },

  "stage": { "inset": 0, "radius": 0, "bleedTop": 100, "bleedBottom": 30, "fade": 90, "fill": ["#090c28", "#1a1248"], "border": "transparent", "borderWidth": 0, "depth": 0, "edge": "#000000" },

  "space": {
    "stars": { "count": 80, "color": "#d6e2ff", "alpha": 0.9, "size": [0.5, 1.7], "twinkle": 0.65, "glints": 0.08 },
    "blobs": [
      { "x": 50, "y": 190, "r": 210, "color": "#5b2bd6", "alpha": 0.3 },
      { "x": 380, "y": 560, "r": 230, "color": "#0fa3b1", "alpha": 0.17 },
      { "x": 350, "y": 110, "r": 150, "color": "#e0439a", "alpha": 0.13 }
    ]
  },

  "globe": {
    "glow": { "color": "#4f7cff", "alpha": 0.6, "spread": 0.2 },
    "base": { "color": "#000000", "depth": 0 },
    "shade": { "color": "#070a2e", "alpha": 0.36, "shift": 0.2, "size": 1.07 },
    "rim": { "color": "#a8d4ff", "alpha": 0.3, "width": 0.028 },
    "limb": { "color": "#7fb0ff", "alpha": 0.5, "width": 3 },
    "outline": { "color": "#000000", "width": 0 },
    "graticule": { "color": "#ffffff", "alpha": 0.05, "width": 1 }
  },

  "land": {
    "fill": "#2bc4a4", "edge": "#127a85", "depth": 2.6, "light": "#7df0cf",
    "coast": { "color": "#000000", "width": 0 },
    "border": { "color": "#0c5a6b", "alpha": 0.55, "width": 0.7 }
  },

  "sst": {
    "steps": ["#1b2a80", "#3b3db8", "#8b3fbf", "#ee4b7a", "#ffa23a"],
    "dim": 0.55, "wobble": 1,
    "isotherm": { "color": "#fff0b8", "alpha": 0.95, "width": 1.7, "dash": [1, 5], "glow": 0.3 }
  },

  "cloud": { "fill": "#ffffff", "shade": "#b9c6ff", "depth": 1.6, "alpha": 0.96, "drift": 1, "stroke": "#000000", "strokeWidth": 0 },

  "storm": {
    "fill": "#ffffff", "shade": "#aebfff", "tired": "#c3c9ee", "depth": 2.4,
    "swirl": "#8fa4f5", "swirlAlpha": 0.9, "eye": "#1b2a80",
    "glow": "#bfd4ff", "glowAlpha": 0.24,
    "shadow": "#060830", "shadowAlpha": 0.27,
    "turn": 2.6, "stroke": "#000000", "strokeWidth": 0
  },

  "ink": {
    "updraft": { "color": "#ffe6b3", "alpha": 0.95, "width": 2.6, "wave": 2.4, "tail": 0.15 },
    "arrow": { "color": "#ffffff", "alpha": 1, "width": 3 },
    "equator": { "color": "#ffffff", "alpha": 0.85, "width": 1.8, "dash": [2, 7], "label": "#ffffff", "labelAlpha": 0.85 },
    "track": { "color": "#ffffff", "alpha": 0.92, "dot": 2.3 },
    "ripple": { "color": "#ffffff", "alpha": 0.8, "width": 2.5 }
  },

  "chip": {
    "fill": "#ffffff", "text": "#1b1f5e", "edge": "#000000", "depth": 0, "radius": 99,
    "border": "transparent", "borderWidth": 0, "size": 13, "weight": 700, "padX": 11, "padY": 6, "upper": false,
    "accentFill": "#ffb238", "accentText": "#2a1650", "accentEdge": "#000000", "accentBorder": "transparent"
  },

  "plate": {
    "fill": "#0f1338", "alpha": 0.84, "radius": 16, "border": "rgba(255,255,255,0.14)", "borderWidth": 1, "depth": 0, "edge": "#000000",
    "barHeight": 10, "barRadius": 3.5, "barStroke": null,
    "size": 11.5, "weight": 600, "text": "#dde4ff", "muted": "#8088c0", "accent": "#ffb238", "stem": 2
  },

  "dock": { "fill": "#0f1338", "alpha": 0.82, "ring": "#ffffff", "ringWidth": 2, "dash": [5, 6], "pulse": "#ffffff", "depth": 0, "edge": "#000000" },

  "finger": { "fill": "#ffffff", "shade": "#c5d0ff", "sleeve": "#ff7a59", "alpha": 0.97, "depth": 2, "stroke": "#000000", "strokeWidth": 0, "touch": "#ffffff" }
}
